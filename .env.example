# ============================================================
# DARWIX VOICE INTELLIGENCE SUITE — Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env
# ============================================================

# ── LLM ─────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── ASR / Voice ──────────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key_here
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id

# ── Express API Gateway ──────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── FastAPI Services ─────────────────────────────────────────
RAG_SERVICE_URL=http://localhost:8001
INGESTION_SERVICE_URL=http://localhost:8002
REALTIME_AI_URL=http://localhost:8003

# ── Vector DB ────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000
FAISS_INDEX_PATH=./knowledge-base/embeddings/faiss_index

# ── Embeddings ───────────────────────────────────────────────
# Options: BAAI/bge-small-en-v1.5 | sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./darwix.db

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
