{
  "name": "veyra-voice-intelligence-suite",
  "version": "1.0.0",
  "description": "Veyra — AI agents that understand every customer conversation.",
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "workspaces": [
    "apps/frontend",
    "apps/api-gateway"
  ],
  "scripts": {
    "tenant": "node scripts/tenant.mjs",
    "test": "npm run test:frontend && npm run test:gateway && npm run test:python && npm run test:tenants && npm run test:provider-inventory && npm run test:grounding",
    "test:frontend": "npm run test --workspace apps/frontend",
    "test:gateway": "npm run test --workspace apps/api-gateway",
    "test:python": "python -m unittest discover -s services -p \"test_*.py\"",
    "test:tenants": "node --test scripts/tenant-runtime.test.mjs",
    "test:provider-inventory": "node --test scripts/provider-inventory.test.mjs",
    "test:grounding": "python services/grounding_eval.py --output evaluation/grounding_report.json",
    "build": "npm run build --workspace apps/frontend",
    "audit:production": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "verify": "npm test && npm run build && npm run audit:all",
    "readiness:providers": "node scripts/provider-inventory.mjs",
    "dev": "node scripts/start-stack.mjs",
    "dev:gateway": "cd apps/api-gateway && npm run dev",
    "dev:frontend": "cd apps/frontend && npm run dev",
    "dev:rag": "node scripts/start-rag.mjs",
    "dev:ingestion": "node scripts/start-python-service.mjs services/ingestion-service INGESTION_SERVICE_URL http://localhost:8002",
    "dev:realtime": "node scripts/start-python-service.mjs services/realtime-insights REALTIME_AI_URL http://localhost:8003 api:app"
  },
  "keywords": [
    "ai",
    "voice-agent",
    "rag",
    "bfsi",
    "nlp"
  ],
  "author": "Veyra",
  "license": "MIT"
}
